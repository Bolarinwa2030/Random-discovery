# Port the API listens on
PORT=3000

# Interface to bind to. Keep 0.0.0.0 so containers and Kubernetes can reach it.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty when the frontend and API share an origin (Vite proxy, ingress path routing).
# Use * to allow any origin.
# Example: CORS_ORIGINS=http://localhost:5173,https://showcase.example.com
CORS_ORIGINS=

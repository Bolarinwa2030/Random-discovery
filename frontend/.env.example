# Used only by the Vite dev server (npm run dev / npm run preview).
# Where /api requests are forwarded to. Default: http://localhost:3000
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Optional: build-time API base URL, baked into the bundle by `npm run build`.
# Leave empty to call the same origin ("/api/..."). For deployments prefer public/config.js,
# which can be changed at runtime without rebuilding.
VITE_API_BASE_URL=

# Set to true if the dev server does not notice file changes (some Docker on Windows/WSL setups).
VITE_USE_POLLING=false

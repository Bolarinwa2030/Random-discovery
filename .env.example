# Used by docker-compose.yml. Copy to .env to override the defaults.
# Running the apps with plain `npm run dev` does not read this file:
# see backend/.env.example and frontend/.env.example instead.

# Host port for the frontend dev server
FRONTEND_PORT=5173

# Port the backend listens on (inside the container and on the host)
BACKEND_PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

# Only needed if a browser calls the API from a different origin.
# The compose setup proxies /api through the frontend, so leave empty.
CORS_ORIGINS=
